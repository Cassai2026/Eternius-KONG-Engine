  questGiver: {fileID: 22283296}
  messagesIncomplete:
  - actorId: 2
    message: Hey what's the lesson for today?
  - actorId: 1
    message: Welcome to Unit 1, Chapter 4! The dungeon.
  - actorId: 1
    message: When you're done, follow the dirt path on the right, cross the zebra
      crossing and talk to my colleague.
  - actorId: 0
    message: Thanks! Can't wait to start
  actorsIncomplete:
  - name: Chase
    sprite: {fileID: 21300000, guid: aed3ac275b8716f44a05b00320f56d38, type: 3}
  - name: Skye
    sprite: {fileID: 21300000, guid: 18104388074fa984dada0fa0fc47d6bb, type: 3}
  - name: Chase
    sprite: {fileID: 21300000, guid: bdabd8443da9a724e97a97ff07190c97, type: 3}
  messagesComplete:
  - actorId: 3
    message: How did i do?
  - actorId: 1
    message: You did great! Now follow the dirt path to the right, over the zebra
      crossing and talk to my colleague for more
  - actorId: 0
    message: Thanks you're amazing!
  actorsComplete:
  - name: Chase
    sprite: {fileID: 21300000, guid: 0ec851fb50b6edf44ae91634554b6722, type: 3}
  - name: Cooper
    sprite: {fileID: 21300000, guid: 30cab7eb0865cf3408a93ec66b251718, type: 3}
