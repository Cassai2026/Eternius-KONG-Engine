MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1457711006}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1e0411ccd31d20d4d863a386c85c267b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  trigger: {fileID: 1457711010}
  questGiver: {fileID: 1457711008}
  messagesIncomplete:
  - actorId: 1
    message: Hey, i have a job for you. Want to take it?
  - actorId: 0
    message: Yes!
  - actorId: 1
    message: Okay, you will earn 3 coins per pipe you collect. Just walk down and
      find it.
  - actorId: 0
    message: Sure i will collect those for you!
  - actorId: 1
    message: Great, one more thing! There is also an enemy we have been very afraid
      of. Could you kill him. I will give you some extra coins for doing that.
  - actorId: 0
    message: Yes i will kill him to death. I will be on my way now
  - actorId: 1
    message: If you noticed, there is some batteries around that will charge you
      up and level you up! Collect those too, for yourself
  actorsIncomplete:
  - name: Mike
    sprite: {fileID: 21300000, guid: 0ec851fb50b6edf44ae91634554b6722, type: 3}
  - name: Desmond
    sprite: {fileID: 21300000, guid: 1fecabb904f784c2485f49cd0a8c3e56, type: 3}
  messagesComplete:
  - actorId: 1
    message: 'Thanks for defeating him! You have earned yourself 20 extra coins. '
  - actorId: 0
    message: Thank you! You're amazing!
  actorsComplete:
  - name: Mike
    sprite: {fileID: 21300000, guid: a4c9c78612b52c74797dc3c5eb7a24c4, type: 3}
  - name: Desmond
    sprite: {fileID: 21300000, guid: 1fecabb904f784c2485f49cd0a8c3e56, type: 3}
